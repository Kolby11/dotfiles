{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "palette": {
        "color_1": "#bcc9c6",
        "color_2": "#c3c7c5",
        "color_3": "#bcc9c6",
        "color_4": "#6b7875",
        "color_5": "#1f201f",
        "color_fg": "#273330",
        "color_fg_dark": "#e4e2e1",
        "color_accent": "#dac1ba",
        "color_warn": "#93000a",
        "color_error": "#ffb4ab",
        "color_info": "#c3c7c5",
        "color_success": "#bcc9c6",
        "color_sep": "#c3c7c5",
        "color_label": "#dac1ba"
    },
    "blocks": [
        {
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "foreground": "p:color_2",
                    "foreground_templates": [
                        "{{ if .Root }}p:color_error{{ end }}"
                    ],
                    "style": "plain",
                    "template": "<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>\u250c\u2500\u2500(</>{{ .UserName }}{{ if .Root }}\ud83d\udc80{{ else }}\u327f{{ end }}{{ .HostName }}<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>)</>",
                    "type": "session",
                    "options": {
                        "display_host": true
                    }
                },
                {
                    "foreground": "p:color_1",
                    "options": {
                        "fetch_version": false,
                        "fetch_virtual_env": true
                    },
                    "style": "plain",
                    "template": "<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>-[</>\ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }}{{ end }}{{ .Full }}{{ end }}<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>]</>",
                    "type": "python"
                },
                {
                    "foreground": "p:color_fg_dark",
                    "options": {
                        "folder_separator_icon": "<#c0c0c0>/</>",
                        "style": "full"
                    },
                    "style": "plain",
                    "template": "<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>-[</>{{ .Path }}<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>]</>",
                    "type": "path"
                },
                {
                    "foreground": "p:color_fg_dark",
                    "style": "plain",
                    "template": "<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>-[</>{{ .HEAD }}<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>]</>",
                    "type": "git"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "right",
            "segments": [
                {
                    "foreground": "p:color_fg_dark",
                    "options": {
                        "always_enabled": true,
                        "style": "round"
                    },
                    "style": "plain",
                    "template": " {{ .FormattedMs }} ",
                    "type": "executiontime"
                },
                {
                    "foreground": "p:color_3",
                    "foreground_templates": [
                        "{{ if gt .Code 0 }}p:color_error{{ end }}"
                    ],
                    "options": {
                        "always_enabled": true
                    },
                    "style": "plain",
                    "template": " {{ if gt .Code 0 }}\uea76{{else}}\uf42e{{ end }} ",
                    "type": "status"
                },
                {
                    "foreground": "p:color_3",
                    "options": {
                        "always_enabled": true,
                        "time_format": "15:04:05"
                    },
                    "style": "plain",
                    "template": " {{ .CurrentDate | date .Format }} ",
                    "type": "time"
                }
            ],
            "type": "prompt"
        },
        {
            "alignment": "left",
            "newline": true,
            "segments": [
                {
                    "foreground": "p:color_3",
                    "style": "plain",
                    "template": "<{{ if .Root }}p:color_2{{ else }}p:color_3{{ end }}>\u2514\u2500</>{{ if .Root }}<p:color_error>#</>{{ else }}${{ end }} ",
                    "type": "text"
                }
            ],
            "type": "prompt"
        }
    ],
    "transient_prompt": {
        "template": "\u200b"
    },
    "secondary_prompt": {
        "background": "transparent",
        "foreground": "p:color_3",
        "template": "\u2514\u2500\u2500 "
    },
    "console_title_template": "{{ .Folder }}{{ if .Root }} :: root{{ end }}",
    "final_space": true,
    "version": 4
}